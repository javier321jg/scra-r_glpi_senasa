# Variables de Entorno - EJEMPLO
# Copia este archivo a .env y llena tus datos reales

# ===================================
# SEGURIDAD
# ===================================

# Clave secreta para Flask (cambiar en produccion)
FLASK_SECRET_KEY=senasa_sistema_tickets_2025_change_in_production

# Contrasena de administrador (cambiar a una segura)
ADMIN_PASSWORD=admin123

# ===================================
# SMTP (CONFIGURACION DE CORREO)
# ===================================

# Servidor SMTP (cambiar si usas otro proveedor)
SMTP_SERVER=mail.senasa.gob.pe

# Puerto SMTP (587 para TLS, 465 para SSL)
SMTP_PORT=587

# Usuario de SMTP (tu email)
SMTP_USER=tu_email@senasa.gob.pe

# Contrasena de SMTP (tu contrasena de email)
SMTP_PASSWORD=tu_contrasena_aqui

# ===================================
# DESTINATARIOS DE CORREO
# ===================================

# Email principal donde se envian los reportes
EMAIL_TO=destino@example.com

# Emails en copia (opcional)
EMAIL_CC=

# Asunto del email
EMAIL_SUBJECT=Reporte de Tickets - SENASA

# Mensaje personalizado del email
EMAIL_MESSAGE=Adjunto encontrara el reporte diario de tickets en curso.

# ===================================
# REDIS (CACHE Y DATOS EN TIEMPO REAL)
# ===================================

# Host de Redis (localhost si es local)
REDIS_HOST=localhost

# Puerto de Redis (por defecto 6379)
REDIS_PORT=6379

# Base de datos de Redis (por defecto 0)
REDIS_DB=0

# Contrasena de Redis (dejar vacio si no tiene)
REDIS_PASSWORD=

# ===================================
# PLANIFICACION (EMAILS AUTOMATICOS)
# ===================================

# Habilitar o deshabilitar envio automatico (True/False)
ENABLE_SCHEDULE=True

# Horarios de envio (separados por comas, formato HH:MM)
SCHEDULE_TIMES=08:00,16:00

# Incluir fin de semana (True/False)
INCLUDE_WEEKENDS=True

# ===================================
# SCRAPING (WEB SCRAPER)
# ===================================

# Habilitar o deshabilitar scraper
SCRAPER_ENABLED=True

# Intervalo en segundos para scraping (300 = 5 minutos)
SCRAPER_INTERVAL_SECONDS=300

# ===================================
# BASE DE DATOS
# ===================================

# Ruta del archivo de base de datos SQLite
DB_PATH=basededatos/tickets_data.db

# ===================================
# APLICACION
# ===================================

# Entorno (development/production)
FLASK_ENV=development

# Debug mode (True/False)
DEBUG=False

# Nivel de logging (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
